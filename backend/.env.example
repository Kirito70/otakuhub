# Environment Configuration for OtakuHub Backend

# Application
APP_NAME=OtakuHub
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://otakuhub:otakuhub@localhost:5432/otakuhub
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# CORS (wildcard '*' is rejected by settings validation)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# JWT (required; insecure placeholders are rejected)
JWT_SECRET=replace-with-64-plus-char-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# External APIs
ANILIST_CLIENT_ID=your-anilist-client-id
ANILIST_CLIENT_SECRET=your-anilist-client-secret
MAL_CLIENT_ID=your-mal-client-id

# Apprise Notifications
APPRISE_URLS=

# Frontend
FRONTEND_URL=http://localhost:8080

# API Prefix
API_V1_PREFIX=/api/v1
