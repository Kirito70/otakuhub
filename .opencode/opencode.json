{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder:30b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://100.124.86.47:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B"
        },
        "llama3.1:8b": {
          "name": "LLaMA 3.1 8B"
        },
        "gpt-oss:latest": {
          "name": "GPT-OSS Latest"
        },
        "tarruda/neuraldaredevil-8b-abliterated:fp16": {
          "name": "Neural Daredevil 8B Abliterated (FP16)"
        }
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    "docs/backend-architecture.md",
    "docs/database-schema.md",
    "docs/flutter-architecture.md"
  ],
  "default_agent": "build",
  "agent": {
    "architect": {
      "description": "System architecture, ADRs, schema decisions, API contract design",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.2
    },
    "backend-dev": {
      "description": "FastAPI routes, services, repositories, Celery workers",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.1
    },
    "flutter-dev": {
      "description": "Flutter screens, Riverpod providers, responsive widgets",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.2
    },
    "db-designer": {
      "description": "Database schema, Alembic migrations, index strategy",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.0
    },
    "code-reviewer": {
      "description": "Code review: correctness, types, tests, security, performance",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.1
    },
    "security-auditor": {
      "description": "Security review: auth, SQL injection, data exposure, prompt injection risks",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.0
    },
    "sync-engineer": {
      "description": "AniList/MangaDex sync pipeline, rate limiting, Celery workers",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.1
    },
    "api-designer": {
      "description": "OpenAPI spec, endpoint contracts, request/response schema design",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.1
    },
    "test-writer": {
      "description": "Write pytest tests for backend, widget tests for Flutter",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.0
    }
  },
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost:5432/otakuhub_dev"]
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."]
    }
  }
}
