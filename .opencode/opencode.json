{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://192.168.1.5:11434/v1"
      },
      "models": {
        "qwen3-coder:latest": {
          "name": "Qwen 3 Coder 30B"
        },
        "gemma4:latest": {
          "name": "Gemma 4 16B"
        },
        "llama3.1:8b": {
          "name": "LLaMA 3.1 8B"
        },
        "gpt-oss:latest": {
          "name": "GPT-OSS Latest"
        },
        "tarruda/neuraldaredevil-8b-abliterated:fp16": {
          "name": "Neural Daredevil 8B Abliterated (FP16)"
        }
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    "docs/agents.md",
    "docs/backend-architecture.md",
    "docs/database-schema.md",
    "docs/quasar-architecture.md"
  ],
  "default_agent": "build",
  "agent": {
    "architect": {
      "description": "System architecture, ADRs, schema decisions, API contract design",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    },
    "backend-dev": {
      "description": "FastAPI routes, services, repositories, Celery workers",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.1
    },
    "quasar-dev": {
      "description": "Quasar/Vue 3 pages, Pinia stores, composables, responsive layout",
      "model": "google/gemini-2.5-pro",
      "temperature": 0.2
    },
    "db-designer": {
      "description": "Database schema, Alembic migrations, index strategy",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.0
    },
    "code-reviewer": {
      "description": "Code review: correctness, types, tests, security, performance",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.1
    },
    "security-auditor": {
      "description": "Security review: auth, SQL injection, data exposure, prompt injection",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.0
    },
    "sync-engineer": {
      "description": "AniList/MangaDex sync pipeline, rate limiting, Celery workers",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.1
    },
    "api-designer": {
      "description": "OpenAPI spec, endpoint contracts, request/response schema design",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.1
    },
    "test-writer": {
      "description": "pytest for backend, Vitest + Vue Test Utils for frontend",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.0
    },
    "tdd-enforcer": {
      "description": "Enforce red-green-refactor workflow and frontend form validation test coverage",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.0
    }
  },
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost:5432/otakuhub_dev"]
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."]
    }
  }
}
