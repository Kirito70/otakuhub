# OtakuHub Flutter — Environment Variables
# Copy this file to .env and fill in your values.
# These are read via String.fromEnvironment() at compile time.
# Pass them with: flutter run --dart-define=BACKEND_URL=...

# Backend API URL (required)
# Default: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Physical device: http://<your-lan-ip>:8000
# Production: https://api.otakuhub.local
BACKEND_URL=http://localhost:8000

# API timeout in seconds (optional, default: 15)
API_TIMEOUT=30

# Enable verbose Dio logging (optional, default: false)
# Set to "true" to see all HTTP request/response bodies in console
DIO_DEBUG=false
